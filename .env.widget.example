# Widget v2.0 Configuration

# REQUIRED: Secret key for signing widget deployment tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WIDGET_SECRET=change-this-to-a-random-secret-key

# Optional: Rate limiting configuration
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Optional: Widget configuration cache
WIDGET_CONFIG_CACHE_TTL_SECONDS=300

# Optional: RAG retrieval limits for widget chat
CHAT_RETRIEVAL_TOP_K_CAP=3

# Optional: Telemetry and logging
LOG_LEVEL=INFO
